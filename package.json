{
  "name": "matrix-programming",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "predev": "npm run wasm",
    "dev": "vite --host 127.0.0.1",
